# Copy to .env at the repo root. Restrict access to the file with chmod 600.

# Set both values on first boot with an empty database. Remove them after sign-in.
LT_ADMIN_EMAIL=admin@example.com
LT_ADMIN_PASSWORD=replace-with-a-long-unique-password

# For remote access, set the public HTTPS origin with no trailing slash.
# LT_PUBLIC_URL=https://transcribe.example.com
# LT_DOMAIN=transcribe.example.com

# The Compose HTTPS profile trusts its dedicated Caddy address by default.
# For a different proxy, set only the CIDRs of its immediate and trusted upstream hops.
# LT_TRUSTED_PROXIES=172.31.253.2/32

# Permit internal calendar destinations by exact hostname or CIDR.
# LT_CALENDAR_ALLOWED_HOSTS=calendar.company.example,10.20.0.0/24

# A 32-byte encryption key encoded with standard base64 (openssl rand -base64 32).
# Leave unset to generate and persist /data/secret.key on first boot.
# LT_SECRET_KEY=

# Local accounts, sessions, and per-user quota (0 = unlimited).
# LT_LOCAL_LOGIN=true
# LT_SESSION_TTL_HOURS=168
# LT_SESSION_IDLE_HOURS=24
# LT_USER_QUOTA_MB=0

# OpenID Connect. Set issuer, client ID, client secret, and LT_PUBLIC_URL together.
# LT_OIDC_ISSUER=https://sso.example.com/realms/local-transcribe
# LT_OIDC_CLIENT_ID=local-transcribe
# LT_OIDC_CLIENT_SECRET=
# LT_OIDC_SCOPES="openid email profile"
# LT_OIDC_PROVIDER_NAME=SSO
# LT_OIDC_ADMIN_GROUP=lt-admins
# LT_OIDC_GROUPS_CLAIM=groups
# Comma-separated allowlists. Unset or empty leaves that filter open.
# LT_OIDC_ALLOWED_GROUPS=lt-admins,lt-users
# LT_OIDC_ALLOWED_DOMAINS=example.com

# Pin an image version instead of latest (with the GPU override, use a -cuda tag).
# LT_IMAGE=ghcr.io/grzeskobyte/local-transcribe:0.1.27
# LT_IMAGE=ghcr.io/grzeskobyte/local-transcribe:0.1.27-cuda

# Container defaults. Update the Compose port mapping and Caddy upstream if
# you change the bind port, or the volume mount if you change the data directory.
# LT_BIND=0.0.0.0:8080
# LT_DATA_DIR=/data
# LT_STATIC_DIR=/opt/lt/dist
# WHISPER_CLI_PATH=/opt/lt/bin/whisper-cli
# LT_DIARIZE_DIR=/opt/lt/diarize

# Keycloak demo only. See deploy/README.md for the matching OIDC values.
# LT_KEYCLOAK_DOMAIN=sso-demo.example.com
