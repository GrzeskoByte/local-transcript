{
  "name": "local-transcribe",
  "private": true,
  "version": "0.1.27",
  "type": "module",
  "description": "Privacy-first local meeting recorder + on-demand transcription (MVP per MVP.md)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:web": "tsc --noEmit && vite build --mode web --base ./ --outDir dist-web",
    "preview:web": "vite preview --mode web --base ./ --outDir dist-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/run.mjs",
    "tauri": "npx --yes @tauri-apps/cli@2",
    "tauri:dev": "npx --yes @tauri-apps/cli@2 dev",
    "tauri:build": "npx --yes @tauri-apps/cli@2 build",
    "bench:native": "node bench/native.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
