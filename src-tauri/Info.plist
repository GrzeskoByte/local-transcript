<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by Tauri. Without a microphone usage
     description macOS denies microphone access outright (no prompt). -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Local Transcriber records your meetings. Audio is stored and transcribed only on this Mac.</string>
</dict>
</plist>
