{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Transcribe",
  "version": "0.1.5",
  "identifier": "io.localtranscribe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Transcribe",
        "width": 1180,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GrzeskoByte",
    "copyright": "© 2026 GrzeskoByte. MIT License.",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Private, on-device meeting recorder and transcriber",
    "longDescription": "Record meetings (microphone, device audio, or both as separate tracks), transcribe them locally with whisper.cpp or voxtype, and summarize them with a local LLM. Your audio never leaves your machine.",
    "homepage": "https://github.com/GrzeskoByte/local-transcript",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MDUwQjk4NDgzMUJCRTIKUldUaXV6RkltQXNGcVIrQ25PbHREb0NlUzlPbFROMDNLTnRhYkhZUmkyS0Q3eXU3MVJ6aEhUTzAK",
      "endpoints": [
        "https://github.com/GrzeskoByte/local-transcript/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
